{
  "bsonType": "object",
  "required": ["user_id", "username", "post_id", "content"],
  "permission": {
    "read": true,
    "create": true,
    "update": false,
    "delete": "doc.user_id == auth.uid"
  },
  "properties": {
    "_id": {
      "bsonType": "string",
      "description": "文档ID"
    },
    "user_id": {
      "bsonType": "string",
      "description": "用户ID"
    },
    "username": {
      "bsonType": "string",
      "description": "昵称",
      "maxLength": 30
    },
    "avatar": {
      "bsonType": "string",
      "description": "头像"
    },
    "post_id": {
      "bsonType": "string",
      "description": "帖子ID",
      "foreignKey": "community_posts._id"
    },
    "content": {
      "bsonType": "string",
      "description": "评论内容",
      "maxLength": 300
    },
    "created_at": {
      "bsonType": "timestamp",
      "description": "创建时间",
      "forceDefaultValue": {
        "$env": "now"
      }
    }
  }
}
